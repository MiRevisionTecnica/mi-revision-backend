          "brand": {
            "type": "string",
            "example": "Chevrolet"
          },
          "model": {
            "type": "string",
            "example": "Cruze LT"
          },
          "year": {
            "type": "number",
            "example": 2018
          },
          "expirations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpirationDto"
            }
          }
        },
        "required": [
          "plate",
          "brand",
          "model"
        ]
      },
      "UpdateVehicleDto": {
        "type": "object",
        "properties": {
