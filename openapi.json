    "/api/reminders/probar-correo": {
      "post": {
        "description": "Manda un correo a la dirección de la cuenta por la misma vía que usan los recordatorios. Es la única forma de saber si van a llegar: que el servicio esté configurado no significa que el proveedor los acepte, y un envío fallido no se nota hasta que alguien reclama que no le avisaron.",
        "operationId": "RemindersController_probarCorreo",
        "parameters": [],
        "responses": {
