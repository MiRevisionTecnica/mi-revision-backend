          },
          "brand": {
            "type": "string",
            "example": "Chevrolet"
          },
          "model": {
            "type": "string",
            "example": "Cruze LT"
          },
          "year": {
            "type": "number",
            "example": 2018
          },
          "expirations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpirationDto"
            }
          }
        }
      },
      "DocumentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "vehicleId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "REVISION_TECNICA",
              "SOAP",
              "PERMISO_CIRCULACION",
              "OTRO"
            ]
          },
          "name": {
            "type": "string"
          },
          "mimeType": {
            "type": "object",
            "nullable": true
          },
          "size": {
            "type": "object",
            "nullable": true
          },
          "storageUrl": {
            "type": "object",
            "nullable": true
          },
          "uploadedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "vehicleId",
          "kind",
          "name",
          "uploadedAt"
        ]
      },
      "CreateDocumentDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "REVISION_TECNICA",
              "SOAP",
              "PERMISO_CIRCULACION",
              "OTRO"
            ],
            "example": "REVISION_TECNICA"
          },
          "name": {
            "type": "string",
            "example": "revision-tecnica-2026.jpg"
          },
          "mimeType": {
            "type": "string",
            "example": "image/jpeg"
          },
