      "PlantResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "prt-25"
          },
          "company": {
            "type": "string",
            "example": "TÜV Rheinland Andino"
          },
          "comuna": {
            "type": "string",
            "example": "La Florida"
          },
          "address": {
            "type": "string",
            "example": "Av. Vicuña Mackenna Poniente 7955"
          },
          "lat": {
            "type": "number",
            "example": -33.515243
          },
          "lng": {
            "type": "number",
            "example": -70.60707
          },
          "classes": {
            "example": [
              "A",
              "B"
            ],
            "description": "A = livianos, B = pesados.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "phone": {
            "type": "object",
            "nullable": true
          },
          "schedule": {
            "type": "object",
            "nullable": true,
            "description": "Tramos de atención por día ({ mon: [{ open: \"08:00\", close: \"18:00\" }], … }). null = no tenemos el dato."
          },
          "scheduleSource": {
            "type": "object",
            "nullable": true,
            "description": "De dónde salió el horario."
          },
          "precision": {
            "type": "string",
            "enum": [
              "places",
              "exact",
              "address",
              "street",
              "comuna"
            ],
            "description": "Qué tan precisa es la ubicación. Bajo \"exact\" conviene avisarlo en pantalla."
          },
          "distanceKm": {
            "type": "number",
            "example": 2.4,
            "description": "Distancia en km. Solo cuando se envían lat y lng."
          },
          "prices": {
            "type": "object",
            "nullable": true,
            "example": [
              {
                "label": "Clase A",
                "amount": 25000
              }
            ],
            "description": "Valores de la revisión. null = no tenemos el dato."
          },
          "pricesUpdatedAt": {
            "type": "object",
            "nullable": true,
            "example": "2026-09-10",
            "description": "Cuándo se verificaron los valores."
          },
          "cameraUrl": {
            "type": "object",
            "nullable": true,
            "description": "Dónde ver el patio de la planta."
          },
          "cameraType": {
            "type": "string",
            "nullable": true,
            "enum": [
              "imagen",
              "pagina"
            ],
            "description": "Cómo mostrarla: 'imagen' es una foto que se refresca sola, 'pagina' una web con la transmisión."
          },
          "tariffUrl": {
            "type": "object",
            "nullable": true,
            "description": "Tarifario completo de la concesionaria, con las categorías que el MTT no publica por planta (motos, eléctricos, a gas, carros de arrastre)."
          }
        },
        "required": [
          "id",
          "company",
          "comuna",
          "address",
          "lat",
          "lng",
          "classes",
          "precision"
        ]
      },
      "RegisterDeviceDto": {
        "type": "object",
        "properties": {
          "pushToken": {
            "type": "string",
            "example": "fH3k…:APA91bF…",
            "description": "Token de push del aparato. En Android es el token de FCM que entrega expo-notifications; en iOS, el de APNs."
          },
          "provider": {
            "type": "string",
            "enum": [
              "fcm",
              "apns"
            ],
            "description": "Con qué servicio se entrega. Lo decide la app según el tipo de token que le dio el sistema, no la plataforma: es lo que evita mandarle a FCM un token de Apple."
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios"
            ]
          }
        },
        "required": [
          "pushToken",
          "provider"
        ]
      },
