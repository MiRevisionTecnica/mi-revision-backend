  "info": {
    "title": "Mi Revisión Técnica — API",
    "description": "Contrato generado desde el código. Ver README.md.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SyncSessionDto": {
        "type": "object",
        "properties": {
          "acceptedTermsVersion": {
            "type": "string",
            "example": "2026-09-09",
            "description": "Versión de los términos aceptados, en formato AAAA-MM-DD. Se manda al crear la cuenta y queda registrada con ella; en un inicio de sesión normal se omite."
          },
          "name": {
            "type": "string",
            "example": "Iván Pérez",
            "description": "Nombre para mostrar, al crear la cuenta. Existe porque el que la app le pone a la cuenta de Firebase puede no estar visible todavía cuando llega esta petición; sin él, el perfil nacería con el correo por nombre. Se ignora si el perfil ya existe."
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "description": "Formas con las que esta cuenta puede iniciar sesión.",
            "items": {
              "type": "string",
              "enum": [
                "password",
                "google"
              ]
            }
          },
          "photoUrl": {
            "type": "object",
            "nullable": true
          },
          "emailReminders": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "licenseExpiresAt": {
            "type": "object",
            "nullable": true,
            "example": "2031-05-20"
          },
          "reminderHour": {
            "type": "number",
            "example": 9,
            "description": "Hora a la que llegan los avisos, en horario de Chile."
          },
          "firstName": {
            "type": "object",
            "nullable": true
          },
          "lastName": {
            "type": "object",
            "nullable": true
          },
          "alias": {
            "type": "object",
            "nullable": true,
            "description": "Cómo prefiere que le hablemos."
          },
          "phone": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "providers",
          "emailReminders",
          "createdAt",
          "licenseExpiresAt",
          "reminderHour",
          "firstName",
          "lastName",
          "alias",
          "phone"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Iván Pérez"
          },
          "firstName": {
            "type": "string",
            "example": "Iván"
          },
          "lastName": {
            "type": "string",
            "example": "Pérez"
          },
          "alias": {
            "type": "object",
            "nullable": true,
            "example": "Nacho",
            "description": "Cómo prefiere que le hablemos. Si está, manda sobre el nombre."
          },
          "phone": {
            "type": "object",
            "nullable": true,
            "example": "+56 9 1234 5678",
            "description": "Teléfono de contacto. Se guarda tal como lo escribe la persona."
          },
          "emailReminders": {
            "type": "boolean",
            "description": "Recibir avisos de vencimiento por correo."
          },
          "reminderHour": {
            "type": "object",
            "nullable": true,
            "minimum": 0,
            "maximum": 23,
            "example": 9,
            "description": "A qué hora del día llegan los avisos, en horario de Chile. Enviar null para volver a la hora por defecto del servidor."
          },
          "licenseExpiresAt": {
            "type": "object",
            "example": "2031-05-20",
            "nullable": true,
            "description": "Vencimiento de la licencia de conducir (AAAA-MM-DD). Va en la cuenta y no en el vehículo porque la licencia es de la persona. Enviar null para dejar de controlarla."
          }
        }
      },
      "ExpirationResponse": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "REVISION_TECNICA",
              "GASES",
              "SOAP",
              "PERMISO_CIRCULACION",
              "LICENCIA_CONDUCIR",
              "OTRO"
            ]
          },
          "dueDate": {
            "type": "string",
            "example": "2026-09-30"
          },
          "daysRemaining": {
            "type": "number",
