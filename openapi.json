        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "REVISION_TECNICA",
              "GASES",
              "SOAP",
              "PERMISO_CIRCULACION",
              "LICENCIA_CONDUCIR",
