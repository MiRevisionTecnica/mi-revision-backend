  "info": {
    "title": "Mi Revisión Técnica — API",
    "description": "Contrato generado desde el código. Ver README.md.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Iván Pérez"
          },
          "email": {
            "type": "string",
            "example": "ivan@ejemplo.cl"
          },
          "password": {
            "type": "string",
            "example": "unaClaveSegura",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "description": "Formas con las que esta cuenta puede iniciar sesión.",
            "items": {
              "type": "string",
              "enum": [
                "password",
                "google"
              ]
            }
          },
          "photoUrl": {
            "type": "object",
            "nullable": true
          },
          "emailReminders": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "providers",
          "emailReminders",
          "createdAt"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "accessToken": {
            "type": "string",
            "description": "Token para el header Authorization: Bearer."
          },
          "refreshToken": {
            "type": "string",
            "description": "Token de larga duración para renovar la sesión."
          },
          "expiresIn": {
            "type": "number",
            "description": "Segundos de validez del access token.",
            "example": 3600
          }
        },
        "required": [
          "user",
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ivan@ejemplo.cl"
          },
          "password": {
            "type": "string",
            "example": "unaClaveSegura"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "GoogleAuthDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "ID token que entrega Google en el teléfono. El backend lo verifica contra los client ID configurados; la app nunca habla con Firebase."
          }
        },
        "required": [
          "idToken"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token entregado al iniciar sesión."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Iván Pérez"
          },
          "emailReminders": {
            "type": "boolean",
            "description": "Recibir avisos de vencimiento por correo."
          }
        }
      },
      "ExpirationResponse": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "REVISION_TECNICA",
              "SOAP",
              "PERMISO_CIRCULACION",
              "OTRO"
            ]
          },
          "dueDate": {
            "type": "string",
            "example": "2026-09-30"
          },
          "daysRemaining": {
            "type": "number",
            "example": 28,
            "description": "Días que faltan. Negativo si ya venció."
          },
          "status": {
            "type": "string",
            "enum": [
              "vigente",
              "por_vencer",
              "vencido"
            ]
          }
        },
        "required": [
          "kind",
          "dueDate",
          "daysRemaining",
          "status"
        ]
      },
      "VehicleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "plate": {
            "type": "string",
            "example": "ABCD12"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "object",
            "nullable": true
          },
          "expirations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpirationResponse"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "plate",
          "brand",
          "model",
          "expirations",
          "createdAt"
