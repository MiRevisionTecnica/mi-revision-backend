    "/api/plants": {
      "get": {
        "description": "Catálogo público de la Región Metropolitana. Con lat y lng el resultado viene ordenado por cercanía e incluye distanceKm.",
        "operationId": "PlantsController_search",
        "parameters": [
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Texto libre: comuna, dirección o empresa.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "comuna",
            "required": false,
            "in": "query",
            "schema": {
              "example": "La Florida",
              "type": "string"
            }
          },
          {
            "name": "lat",
            "required": false,
            "in": "query",
            "description": "Latitud del usuario. Con lat y lng el listado se ordena por cercanía.",
            "schema": {
              "example": -33.4489,
              "type": "number"
            }
          },
          {
            "name": "lng",
            "required": false,
            "in": "query",
            "schema": {
              "example": -70.6693,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "maximum": 200,
              "default": 50,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlantResponse"
                  }
                }
              }
            }
          }
        },
        "summary": "Buscar plantas de revisión técnica",
        "tags": [
          "Plantas PRT"
        ]
      }
    },
