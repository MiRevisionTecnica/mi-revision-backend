# --- Firebase (base de datos) ---
# Consíguela en la consola de Firebase:
#   Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Define UNA de las tres opciones.
#
# Opción 1 (la más simple en local): ruta al archivo JSON descargado.
#   Usa barras normales, incluso en Windows. El archivo NO va al repositorio.
GOOGLE_APPLICATION_CREDENTIALS=

# Opción 2 (la más cómoda en Railway): el JSON completo en base64.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("clave.json")) | Set-Clipboard
#   Linux/macOS: base64 -w0 clave.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Opción 3: los tres campos por separado. En PRIVATE_KEY los saltos de línea
# van escapados, tal como aparecen en el JSON descargado.
FIREBASE_PROJECT_ID=mi-revision-tecnica
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Aplicación ---
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por coma. '*' para desarrollo.
CORS_ORIGINS=*

# --- Autenticación ---
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30

# --- Entrar con Google ---
# Client ID de OAuth aceptados al validar el ID token, separados por coma
# (el de web y el de Android). Se obtienen al habilitar Google como proveedor
# en Firebase Authentication. Sin esto, POST /api/auth/google responde 503.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Datos de plantas (opcional) ---
# Clave de Google Cloud con "Places API (New)" habilitada. Solo la usa
# "npm run enrich:plants" para traer horarios y coordenadas exactas.
GOOGLE_MAPS_API_KEY=

# --- Reglas de negocio ---
# Fase 1: 1 vehículo por cuenta. Fase 2 se sube este número.
MAX_VEHICLES_PER_USER=1

# --- Recordatorios ---
REMINDERS_ENABLED=true
# Días de anticipación de los avisos.
REMINDER_OFFSETS=30,15,7,1,0
# Hora local (America/Santiago) del envío diario.
REMINDER_HOUR=9
# Protege POST /api/reminders/run. Sin esta variable el endpoint queda deshabilitado.
CRON_SECRET=

# --- Correo (opcional: sin SMTP solo se envían push) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Mi Revisión Técnica <no-reply@mirevisiontecnica.cl>"

# --- Push (opcional) ---
# Token de Expo para envíos con credenciales mejoradas.
EXPO_ACCESS_TOKEN=
