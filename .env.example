# --- Firebase (base de datos) ---
# Consíguela en la consola de Firebase:
#   Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Define UNA de las tres opciones.
#
# Opción 1 (la más simple en local): ruta al archivo JSON descargado.
#   Usa barras normales, incluso en Windows. El archivo NO va al repositorio.
GOOGLE_APPLICATION_CREDENTIALS=

# Opción 2 (la más cómoda en Railway): el JSON completo en base64.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("clave.json")) | Set-Clipboard
#   Linux/macOS: base64 -w0 clave.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Opción 3: los tres campos por separado. En PRIVATE_KEY los saltos de línea
# van escapados, tal como aparecen en el JSON descargado.
FIREBASE_PROJECT_ID=mi-revision-tecnica
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Aplicación ---
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por coma. '*' para desarrollo.
CORS_ORIGINS=*

# --- Autenticación ---
# No hay nada que configurar. Las sesiones las emite Firebase Authentication
# desde la app y las verifica el SDK de administrador con las credenciales de
# arriba. Crear cuenta, entrar con Google y recuperar la contraseña tampoco
# pasan por la API.

# --- Datos de plantas (opcional) ---
# Clave de Google Cloud con "Places API (New)" habilitada. Solo la usa
# "npm run enrich:plants" para traer horarios y coordenadas exactas.
GOOGLE_MAPS_API_KEY=

# --- Reglas de negocio ---
# Fase 1: 1 vehículo por cuenta. Fase 2 se sube este número.
MAX_VEHICLES_PER_USER=1

# --- Recordatorios ---
REMINDERS_ENABLED=true
# Días de anticipación de los avisos.
REMINDER_OFFSETS=30,15,7,1,0
# Hora local (America/Santiago) para quien no eligió una en su perfil.
# El envío se revisa cada hora y respeta la hora de cada persona.
REMINDER_HOUR=9
# Protege POST /api/reminders/run. Sin esta variable el endpoint queda deshabilitado.
CRON_SECRET=

# --- Correo ---
# Sin esto los avisos salen solo por push y la recuperación de contraseña no
# funciona: la persona pide su código y espera un correo que nunca sale.
#
# Se prefiere Resend, que envía por HTTPS. Railway --como casi toda nube--
# bloquea las salidas por los puertos de SMTP para no ser fuente de spam, y el
# síntoma es un "Connection timeout" seco que parece un problema de credenciales.
# No hay variable que lo arregle: hay que salir por el puerto 443.
#
# En resend.com: crear cuenta, verificar el dominio mirevisionapp.cl con los
# registros DNS que entrega (van en Cloudflare) y generar una clave.
# El plan gratuito da 3.000 correos al mes.
RESEND_API_KEY=
MAIL_FROM="Mi Revisión Técnica <no-reply@mirevisionapp.cl>"

# SMTP queda como alternativa para un servidor propio, donde sí funciona.
# Si RESEND_API_KEY está definida, esto se ignora.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Push ---
# No hay nada que configurar. Las notificaciones salen por Firebase Cloud
# Messaging con las mismas credenciales de arriba.
